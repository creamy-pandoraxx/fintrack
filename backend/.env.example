NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Reverse proxies in front of the API (0 = none, 1 = one proxy such as Railway).
TRUST_PROXY=0
# Optional. Comma-separated browser origins allowed by CORS. Empty = CORS off.
# CORS_ORIGINS=https://app.example.com
# Per-IP request limit on /api/v1 (defaults: 300 requests per 60000 ms).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
DATABASE_URL="postgresql://fintrack:fintrack_password@localhost:5433/fintrack_db?schema=public"

FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
